# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
# Anchored with a leading "/": these are setuptools/PyPI output written at the REPO ROOT.
# Unanchored, they match at ANY depth — `lib/` was silently swallowing apps/web/src/lib/
# (the entire webapp core) so `git add apps/web` staged nothing from it.
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
/*.egg-info/
.installed.cfg
*.egg

# Virtual environments (likewise root-level; an unanchored `env/` would hide any nested env dir)
/venv/
/env/
/ENV/
/.venv/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Project-specific installer artifacts
*.deb
*.rpm

# Local outputs (keep reports in repo, but ignore temporary renders).
# Anchored: unanchored it would also hide any nested `tmp/` (this class of pattern is what hid
# `apps/web/src/lib/` — see the `lib/` note above).
/tmp/
*.tmp

# Test / coverage artifacts
.coverage
.pytest_cache/
.ruff_cache/

# Node / Next.js (apps/landing-page)
node_modules/
.next/
*.tsbuildinfo

# Tooling scratch / session state
.playwright-mcp/

# Client intake records — may contain personal data; not for version control
candidates_horoscope/intake/*
!candidates_horoscope/intake/.gitkeep

# Stray dev screenshots
/landing-hero.png
/landing-viewport.png
/time_click.png

# Firecrawl research cache
.firecrawl/
