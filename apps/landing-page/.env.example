# ── SMTP Configuration (Gmail) ──
# Required for sending emails via the contact and submit API routes.
# Use a Gmail App Password (not your regular password).
# https://support.google.com/accounts/answer/185833
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here

# ── Upstash Redis (optional but recommended for production rate limiting) ──
# If omitted, the API falls back to an in-memory rate limiter (works fine for
# local dev and low-traffic sites, but is per-instance on Vercel).
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# ── Destination email for form submissions ──
# Defaults to cosmicsaju@gmail.com if not set.
TO_EMAIL=cosmicsaju@gmail.com

# ── Site URL / contact email (exposed to the browser) ──
NEXT_PUBLIC_SITE_URL=https://cosmicsaju.com
NEXT_PUBLIC_TO_EMAIL=cosmicsaju@gmail.com

# ── Saju calculator (FastAPI self-service PDF backend) ──
# URL of the FastAPI app that serves /generate for the free sample tier.
SAJU_CALCULATOR_URL=http://localhost:8080

# ── Allowed origins for the FastAPI CORS middleware ──
# Comma-separated list of origins allowed to call /generate directly.
SAJU_ALLOWED_ORIGINS=http://localhost:3000