# ─────────────────────────────────────────────────────────────
# Cosmic Saju webapp — environment variables
# Copy to .env.local for local dev. NEVER commit real values.
# Full inventory and rationale: docs/webapp/08-deployment.md
# ─────────────────────────────────────────────────────────────

# ── Neon Postgres ──
# DATABASE_URL:          POOLED connection string (runtime traffic)
# DIRECT_URL:            DIRECT/unpooled connection string (migrations only)
# DATABASE_URL_UNPOOLED: the same unpooled string, present in Vercel for tooling/`prisma migrate`
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── Neon Auth (managed Better Auth) ──
# Base URL INCLUDES the path. This exact string determines the Google redirect URI:
#   {NEON_AUTH_BASE_URL}/callback/google
NEON_AUTH_BASE_URL=https://ep-raspy-morning-a1xq0p8c.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth
# JWKS endpoint (for JWT/token verification if you need it):
#   https://ep-raspy-morning-a1xq0p8c.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth/.well-known/jwks.json
# Generate with: openssl rand -base64 32   (must be >= 32 chars)
NEON_AUTH_COOKIE_SECRET=replace-with-a-32-char-plus-secret

# ── Cloudflare R2 (private report storage) ──
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=cosmic-saju-dev
R2_REGION=auto
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# ── Report engine service (Vercel project #2) ──
# The FastAPI service that renders PDFs. Point at http://localhost:8000 in dev.
ENGINE_URL=http://localhost:8000
ENGINE_SERVICE_TOKEN=replace-with-a-shared-secret

# ── Email (Resend) ──
RESEND_API_KEY=
EMAIL_FROM=Cosmic Saju <reports@cosmicsaju.com>
# Where a client's reply lands. Messages invite replies ("just reply to this email"), and
# EMAIL_FROM is a sending identity nobody sits in — so this must be a real, monitored inbox.
EMAIL_REPLY_TO=hello@cosmicsaju.com

# ── Voice (ElevenLabs) — the audio summary for the Deep tier ──
# API key: elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=
# The voice to narrate with: elevenlabs.io → Voices → copy the voice id
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 is the cheapest and is multilingual (the reports carry romanised
# Korean and Chinese terms). Override only if you need more expressiveness.
ELEVENLABS_MODEL=eleven_flash_v2_5
# Characters per request: 40,000 is allowed on a paid plan, 5,000 on eleven_v3 and only
# 2,500 on a free one. The script is chunked on sentence boundaries, so a larger value
# just means fewer joins.
ELEVENLABS_MAX_CHUNK_CHARS=2000

# ── Payments (Dodo Payments — merchant of record) ──
# API key: Dashboard → Developer → API Keys
DODO_PAYMENTS_API_KEY=
# Webhook signing secret: Dashboard → Developer → Webhooks → your endpoint → Overview
# Standard Webhooks spec; may start with `whsec_`
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode | live_mode  (test_mode -> https://test.dodopayments.com)
DODO_PAYMENTS_ENVIRONMENT=test_mode
# One product per tier: Dashboard → Products → copy the product id (pdt_…)
DODO_PRODUCT_ESSENTIAL=
DODO_PRODUCT_DEEP=
DODO_PRODUCT_COMPAT_BASIC=
DODO_PRODUCT_COMPAT_DEEP=
# NOTE: the checkout return_url is derived from NEXT_PUBLIC_APP_URL — one source of truth, no
# separate DODO_PAYMENTS_RETURN_URL to drift out of sync.

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=privacy@cosmicsaju.com
# General contact (support, refunds, "where's my report?"). privacy@ is reserved for
# data-protection requests only; see src/lib/contact.ts.
NEXT_PUBLIC_CONTACT_EMAIL=hello@cosmicsaju.com
# Comma-separated. Admin = DB role ADMIN **and** an email in this list (two independent gates).
ADMIN_EMAILS=
# Vercel Cron sends this as `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=

# ── Optional ──
# Rollout switch: off (default) | log (verify + record, NEVER block) | enforce.
# Start at `log` so a widget that fails to render cannot take the free-sample funnel down.
TURNSTILE_MODE=off
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
